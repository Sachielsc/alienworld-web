# Copy to .env (never commit .env). In production, docker-compose passes these to the container.

# Long random string, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin account, seeded/updated on server start. Do NOT reuse the old site password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- ai-council (dev only, not needed by the running site) ---
# Advisory seats for the /frontend-beautify skill. Leave blank to make a seat fall
# back to Claude Code self-performing that role. See tools/ai-council/config.json.
# UI/UX Designer seat - free tier at https://aistudio.google.com
GEMINI_API_KEY=
# Senior Reviewer seat - free tier at https://openrouter.ai
OPENROUTER_API_KEY=
