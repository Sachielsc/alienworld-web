# node modules
node_modules

# IntelliJ project files
.idea
*.iml

# build output
client/dist

# runtime data (SQLite db, sessions)
server/data

# environment secrets
.env

# playwright MCP output (screenshots, page snapshots) - throwaway run artifacts.
# The MCP server is sandboxed to the repo, so captures must land here rather than
# in a temp dir. Ignoring keeps them out of history; ask.mjs still reads them fine.
.playwright-mcp/
